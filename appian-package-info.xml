<?xml version="1.0" encoding="UTF-8"?>
<!--
  AON Performance Monitoring Dashboard
  Pacchetto Appian per il monitoraggio delle performance applicative di Hygieia.

  Versione : 1.0.0
  Prefisso : AON_PERF_

  Contenuto:
    - 5 Constants          (configurazione soglie, destinatari, parametri)
    - 5 Expression Rules   (query metriche, trend, alert)
    - 2 Interfaces         (dashboard principale, configurazione alert)
    - 2 Process Models     (monitor schedulato, invio notifica)
-->
<appian-package xmlns="http://www.appian.com/ae/pkg/1.0">
  <package-info>
    <name>AON - Performance Monitoring Dashboard</name>
    <description>
      Dashboard di monitoraggio dei tempi di esecuzione di Modelli di Processo,
      Interfacce e Integrazioni. Include sistema di alerting per processi bloccati.
    </description>
    <version>1.0.0</version>
    <build-date>2026-02-18</build-date>
  </package-info>
</appian-package>
