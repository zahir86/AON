<?xml version="1.0" encoding="UTF-8"?>
<!--
  AON_PERF_MONITORED_PROCESS_MODELS
  Lista JSON dei modelli di processo critici da tenere sotto controllo.
  Formato array JSON: ["Nome Processo 1", "Nome Processo 2", ...]

  Il monitor schedulato verifica che questi processi non siano bloccati.
  La dashboard mostra metriche prioritarie per questi processi.

  CONFIGURARE con i nomi esatti dei Process Model in Appian.
  Esempio tipico per Hygieia:
    ["Invio Mail", "Sincronizzazione Dati", "Generazione Report", "Import Anagrafiche"]
-->
<ae:constant xmlns:ae="http://www.appian.com/ae/types/2009"
             name="AON_PERF_MONITORED_PROCESS_MODELS"
             type="Text"
             value='["Invio Mail", "Sincronizzazione Dati", "Generazione Report", "Import Anagrafiche"]'
             description="Array JSON con i nomi dei Process Model critici monitorati. Aggiornare con i nomi esatti dei processi nell'ambiente."/>
