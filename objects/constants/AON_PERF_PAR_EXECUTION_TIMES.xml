<?xml version="1.0" encoding="UTF-8"?>
<!--
  AON_PERF_PAR_EXECUTION_TIMES
  UUID del Process Analytics Report (PAR) configurato in Appian per
  il monitoraggio dei tempi di esecuzione.

  PREREQUISITO: Creare il PAR come descritto in docs/setup-guide.md
  con le seguenti colonne (in quest'ordine):
    c1 = Process Name (Nome istanza di processo)
    c2 = Process Model Name (Nome del modello di processo)
    c3 = Start Time (Data/ora di avvio)
    c4 = Completion Time (Data/ora di completamento, null se attivo)
    c5 = Elapsed Time in seconds (Durata in secondi)
    c6 = Status (ACTIVE | COMPLETED | CANCELLED | ERROR | PAUSED)
    c7 = Initiator (Username avviatore)

  Dopo aver creato il PAR, sostituire il valore con il suo UUID
  visibile nell'URL: /suite/rest/a/applications/latest/self/report/<UUID>
-->
<ae:constant xmlns:ae="http://www.appian.com/ae/types/2009"
             name="AON_PERF_PAR_EXECUTION_TIMES"
             type="Text"
             value="CONFIGURARE-UUID-PAR-QUI"
             description="UUID del Process Analytics Report per i tempi di esecuzione. Vedi docs/setup-guide.md per la configurazione."/>
