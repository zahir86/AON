<?xml version="1.0" encoding="UTF-8"?>
<!--
  AON_PERF_STUCK_THRESHOLD_MINS
  Soglia in minuti oltre la quale un processo attivo viene considerato "bloccato".
  Il monitor schedulato (AON_PERF_ScheduledMonitor) usa questa soglia
  per rilevare processi come l'invio mail, importazioni, ecc.

  Configurare per ogni ambiente:
    - DEV  : 120 min (tolleranza più alta)
    - TEST : 90  min
    - PROD : 60  min (default)
-->
<ae:constant xmlns:ae="http://www.appian.com/ae/types/2009"
             name="AON_PERF_STUCK_THRESHOLD_MINS"
             type="Integer"
             value="60"
             description="Soglia in minuti oltre la quale un processo attivo è considerato bloccato e genera un alert (default: 60)."/>
